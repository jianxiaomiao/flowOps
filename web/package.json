  },
  "dependencies": {
    "@element-plus/icons-vue": "latest",
    "axios": "latest",
    "element-plus": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "typescript": "~5.9.3",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
