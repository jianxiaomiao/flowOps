# Copy this file to .env before starting Docker Compose.
# Keep the real .env local; it is ignored by Git. Values below are placeholders.
COMPOSE_PROJECT_NAME=flowops

# MySQL application account and root account. Use different strong passwords.
FLOWOPS_DB_NAME=flowops
FLOWOPS_DB_USERNAME=flowops
FLOWOPS_DB_PASSWORD=
FLOWOPS_DB_ROOT_PASSWORD=
FLOWOPS_MYSQL_PORT=3306

# Redis persists its AOF data in the redis-data volume and requires authentication.
FLOWOPS_REDIS_PASSWORD=
FLOWOPS_REDIS_PORT=6379

# RabbitMQ account used by the application.
FLOWOPS_RABBITMQ_USER=flowops
FLOWOPS_RABBITMQ_PASSWORD=
FLOWOPS_RABBITMQ_VHOST=flowops
FLOWOPS_RABBITMQ_AMQP_PORT=5672
FLOWOPS_RABBITMQ_MANAGEMENT_PORT=15672

# At least 32 random bytes. Never reuse a development JWT secret in production.
FLOWOPS_JWT_SECRET=

# AI & Vector Database
FLOWOPS_OLLAMA_URL=http://host.docker.internal:11434
FLOWOPS_OLLAMA_EMBEDDING_MODEL=dengcao/Qwen3-Embedding-4B:Q4_K_M
FLOWOPS_MILVUS_HOST=milvus
FLOWOPS_MILVUS_PORT=19530

# Host ports and production-like feature flags for Docker Compose.
FLOWOPS_BACKEND_PORT=8080
FLOWOPS_WEB_PORT=5173
FLOWOPS_REGISTRATION_ENABLED=false
FLOWOPS_REGISTRATION_EMAIL_VERIFICATION_ENABLED=true

# QQ SMTP mail configuration for registration email verification codes.
FLOWOPS_MAIL_HOST=smtp.qq.com
FLOWOPS_MAIL_PORT=465
FLOWOPS_MAIL_USERNAME=
FLOWOPS_MAIL_PASSWORD=

# Observability UI. Grafana uses a separate local administrator password.
FLOWOPS_PROMETHEUS_PORT=9090
FLOWOPS_GRAFANA_PORT=3000
FLOWOPS_GRAFANA_ADMIN_USER=admin
FLOWOPS_GRAFANA_ADMIN_PASSWORD=
